{
  "name": "@iopsych/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./definitions/v1/*": "./definitions/v1/*",
    "./schemas/v1/*": "./schemas/v1/*"
  },
  "files": [
    "definitions",
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "schemas": "tsx scripts/generate-json-schemas.ts",
    "lint": "eslint src scripts vitest.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.18.6",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
