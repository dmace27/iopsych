{
  "$id": "https://iopsych.local/contracts/v1/assessment-definition.schema.json",
  "title": "Assessment definition",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string", "enum": ["draft", "published", "retired"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "blocks": {
      "minItems": 6,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "position": { "type": "integer", "minimum": 1, "maximum": 6 },
          "items": {
            "minItems": 4,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
                },
                "construct_key": {
                  "type": "string",
                  "enum": [
                    "autonomy",
                    "structure",
                    "ambiguity",
                    "collaboration",
                    "mastery",
                    "pace"
                  ]
                },
                "statement": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": ["id", "construct_key", "statement"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "position", "items"],
        "additionalProperties": false
      }
    },
    "scoring": {
      "type": "object",
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "choice_weights": {
          "type": "object",
          "properties": {
            "most_like": { "type": "number", "const": 1 },
            "least_like": { "type": "number", "const": -1 }
          },
          "required": ["most_like", "least_like"],
          "additionalProperties": false
        },
        "rating_thresholds": {
          "minItems": 5,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
              "minimum_raw_score": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "maximum_raw_score": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": ["rating", "minimum_raw_score", "maximum_raw_score"],
            "additionalProperties": false
          }
        },
        "candidate_confidence": {
          "type": "object",
          "properties": {
            "high": {
              "type": "object",
              "properties": {
                "level": { "type": "string", "const": "high" },
                "minimum_skipped_items": { "type": "number", "const": 0 },
                "maximum_skipped_items": { "type": "number", "const": 0 }
              },
              "required": [
                "level",
                "minimum_skipped_items",
                "maximum_skipped_items"
              ],
              "additionalProperties": false
            },
            "medium": {
              "type": "object",
              "properties": {
                "level": { "type": "string", "const": "medium" },
                "minimum_skipped_items": { "type": "number", "const": 1 },
                "maximum_skipped_items": { "type": "number", "const": 1 }
              },
              "required": [
                "level",
                "minimum_skipped_items",
                "maximum_skipped_items"
              ],
              "additionalProperties": false
            },
            "low": {
              "type": "object",
              "properties": {
                "level": { "type": "string", "const": "low" },
                "minimum_skipped_items": { "type": "number", "const": 2 },
                "maximum_skipped_items": { "type": "null" }
              },
              "required": [
                "level",
                "minimum_skipped_items",
                "maximum_skipped_items"
              ],
              "additionalProperties": false
            }
          },
          "required": ["high", "medium", "low"],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "choice_weights",
        "rating_thresholds",
        "candidate_confidence"
      ],
      "additionalProperties": false
    }
  },
  "required": ["id", "version", "status", "title", "blocks", "scoring"],
  "additionalProperties": false
}
