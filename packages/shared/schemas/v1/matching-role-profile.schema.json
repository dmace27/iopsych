{
  "$id": "https://iopsych.local/contracts/v1/matching-role-profile.schema.json",
  "title": "Matching role profile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "approved": { "type": "boolean" },
    "constructs": {
      "minItems": 6,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "autonomy",
              "structure",
              "ambiguity",
              "collaboration",
              "mastery",
              "pace"
            ]
          },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "rationale": { "type": "string", "minLength": 1 },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["key", "rating", "confidence", "rationale", "evidence"],
        "additionalProperties": false
      }
    }
  },
  "required": ["approved", "constructs"],
  "additionalProperties": false
}
