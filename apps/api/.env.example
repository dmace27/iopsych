# Server settings. These values are safe defaults for local development.
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# PostgreSQL 16 database used by SQLAlchemy and Alembic.
DATABASE_URL=postgresql+psycopg://iopsych:iopsych@localhost:5432/iopsych
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5

# Internal-user JWT verification. Replace the local key in every hosted
# environment through its secret manager; it must contain at least 32 bytes.
AUTH_JWT_SECRET=local-development-only-secret-change-me-0123456789
AUTH_JWT_ISSUER=https://auth.example.invalid
AUTH_JWT_AUDIENCE=iopsych-api
AUTH_JWT_LEEWAY_SECONDS=30

# Candidate invitations fail closed unless a provider adapter and a secret of
# at least 32 bytes are configured. Never log candidate invitation URLs.
INVITE_TOKEN_SIGNING_SECRET=replace-with-at-least-32-random-bytes
INVITE_CANDIDATE_BASE_URL=http://localhost:3000/candidate/invites
INVITE_DEFAULT_EXPIRY_HOURS=168
INVITE_MAXIMUM_EXPIRY_HOURS=720
INVITE_CANDIDATE_RATE_LIMIT=30
INVITE_INTERNAL_RATE_LIMIT=20
INVITE_RATE_WINDOW_SECONDS=60

# Structured role extraction fails closed when no API key is configured. The
# provider receives role metadata and job-description text only; validated
# output is always saved as a draft for separate hiring-manager approval.
ROLE_EXTRACTION_PROVIDER=openai
ROLE_EXTRACTION_API_KEY=
ROLE_EXTRACTION_MODEL=gpt-5-mini
ROLE_EXTRACTION_BASE_URL=https://api.openai.com/v1
ROLE_EXTRACTION_TIMEOUT_SECONDS=30
ROLE_EXTRACTION_MAX_ATTEMPTS=3
ROLE_EXTRACTION_RETRY_BASE_DELAY_SECONDS=0.2

# Candidate data is anonymized after this bounded pilot retention window. Run
# `python -m app.privacy.retention` from apps/api on the deployment scheduler.
PRIVACY_RETENTION_DAYS=90
PRIVACY_RETENTION_BATCH_SIZE=100
INVITE_CONSENT_NOTICE_VERSION=pilot-v1
INVITE_RETENTION_STATEMENT=Pilot data is retained for {retention_days} days after submission, then anonymized.
INVITE_PRIVACY_CONTACT_EMAIL=privacy@example.invalid
INVITE_ACCOMMODATION_CONTACT_EMAIL=accommodations@example.invalid
