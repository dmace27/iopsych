# Server-only FastAPI base URL used by the same-origin internal API proxy.
API_BASE_URL=http://localhost:8000

# Auth0 Regular Web Application, using its Universal Login page.
# Set these server-only values through the deployment secret manager.
APP_BASE_URL=http://localhost:3000
AUTH0_ISSUER=https://your-tenant.example.auth0.com/
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=iopsych-api
# Generate at least 32 random bytes; all web replicas must share this secret.
AUTH_SESSION_SECRET=
# Deterministic smoke tests alone explicitly enable manual token exchange.
ENABLE_TOKEN_SIGN_IN=false
